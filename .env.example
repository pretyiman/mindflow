DATABASE_URL="postgresql://mindmup:mindmup@localhost:5433/mindmup?schema=public"
PORT=4000
# Leave unset for local dev - the client defaults to a relative /api path,
# proxied to the backend by Vite (works through a tunnel too). Only set this
# if the frontend and backend are genuinely on different hosts.
# VITE_API_BASE_URL="http://localhost:4000/api"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRY="7d"
