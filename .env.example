DATABASE_URL="postgresql://mindmup:mindmup@localhost:5433/mindmup?schema=public"
PORT=4000
# Leave unset for local dev - the client defaults to a relative /api path,
# proxied to the backend by Vite (works through a tunnel too). Only set this
# if the frontend and backend are genuinely on different hosts.
# VITE_API_BASE_URL="http://localhost:4000/api"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRY="7d"

# Base URL the client is actually served from - used to build the link
# inside verification emails. Defaults to Vite's local dev URL if unset.
APP_URL="http://localhost:5173"

# All optional - without them, verification emails fall back to a disposable
# Ethereal test account (logged to the server console as a preview link
# instead of actually delivering anywhere). Fill in to send real email, e.g.
# via a Gmail App Password (myaccount.google.com/apppasswords).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Mindflow <you@gmail.com>"

# Optional - "Sign in with Google" is simply not offered on the login page
# until both of these are set. Create an OAuth Client ID at
# console.cloud.google.com/apis/credentials (no billing/card required).
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
